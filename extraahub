local function CreateSlider(parent, labelText, min, max, default, isOpacity, callback)
    local Row = Instance.new("Frame", parent)
    Row.Size = UDim2.new(1, -24, 0, 36)
    Row.Position = UDim2.new(0, 12)
    Row.BackgroundTransparency = 1
    Row.ZIndex = 7
    Row.LayoutOrder = 1

    local Label = Instance.new("TextLabel", Row)
    Label.Size = UDim2.new(0.5, 0, 1, 0)
    Label.BackgroundTransparency = 1
    Label.Text = labelText
    Label.TextColor3 = Color3.fromRGB(190, 200, 220)
    Label.Font = Enum.Font.Gotham
    Label.TextSize = 12
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.ZIndex = 8

    local ValueBox = Instance.new("Frame", Row)
    ValueBox.Size = UDim2.new(0, 34, 0, 17)
    ValueBox.Position = UDim2.new(1, -34, 0.5, -8.5)
    ValueBox.BackgroundColor3 = Color3.fromRGB(10, 13, 20)
    ValueBox.ZIndex = 8
    ValueBox.BorderSizePixel = 0
    local VBCorner = Instance.new("UICorner", ValueBox)
    VBCorner.CornerRadius = UDim.new(0, 3)
    local VBStroke = Instance.new("UIStroke", ValueBox)
    VBStroke.Color = Color3.fromRGB(40, 48, 68)
    VBStroke.Thickness = 1
    VBStroke.Transparency = 0.5

    local ValueLabel = Instance.new("TextLabel", ValueBox)
    ValueLabel.Size = UDim2.new(1, 0, 1, 0)
    ValueLabel.BackgroundTransparency = 1
    ValueLabel.Text = isOpacity and string.format("%.2f", default) or tostring(default)
    ValueLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    ValueLabel.Font = Enum.Font.GothamBold
    ValueLabel.TextSize = 10
    ValueLabel.ZIndex = 9

    local Track = Instance.new("Frame", Row)
    Track.Size = UDim2.new(1, -42, 0, 2)
    Track.Position = UDim2.new(0, 0, 1, -5)
    Track.BackgroundColor3 = Color3.fromRGB(40, 48, 68)
    Track.ZIndex = 8
    Track.BorderSizePixel = 0
    local TCorner = Instance.new("UICorner", Track)
    TCorner.CornerRadius = UDim.new(1, 0)

    local pct = math.clamp((default - min) / (max - min), 0, 1)
    local Fill = Instance.new("Frame", Track)
    Fill.Size = UDim2.new(pct, 0, 1, 0)
    Fill.BackgroundColor3 = Color3.fromRGB(60, 120, 255)
    Fill.ZIndex = 9
    Fill.BorderSizePixel = 0
    local FCorner = Instance.new("UICorner", Fill)
    FCorner.CornerRadius = UDim.new(1, 0)

    local Handle = Instance.new("TextButton", Track)
    Handle.Size = UDim2.new(0, 11, 0, 11)
    Handle.Position = UDim2.new(pct, -5.5, 0.5, -5.5)
    Handle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Handle.Text = ""
    Handle.ZIndex = 10
    Handle.BorderSizePixel = 0
    local HCorner = Instance.new("UICorner", Handle)
    HCorner.CornerRadius = UDim.new(1, 0)

    local dragging = false
    Handle.MouseButton1Down:Connect(function() dragging = true end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            local pos = i.Position
            local absP = Track.AbsolutePosition
            local absS = Track.AbsoluteSize
            if absS.X <= 0 then return end
            local pct = math.clamp((pos.X - absP.X) / absS.X, 0, 1)
            local val = min + ((max - min) * pct)
            if isOpacity then
                val = math.floor(val * 100) / 100
                ValueLabel.Text = string.format("%.2f", val)
            else
                val = math.floor(val)
                ValueLabel.Text = tostring(val)
            end
            callback(val)
            Handle.Position = UDim2.new(pct, -5.5, 0.5, -5.5)
            Fill.Size = UDim2.new(pct, 0, 1, 0)
        end
    end)
    return Row
end

