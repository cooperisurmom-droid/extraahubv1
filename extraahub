local WESTBOUND_PLACE_ID = 2474168535
local WESTBOUND_GAME_ID = 873703865
local isWestbound = (game.PlaceId == WESTBOUND_PLACE_ID) or (game.GameId == WESTBOUND_GAME_ID)

local function getUniversalTargetPart(character)
    if isWestbound then return character:FindFirstChild("Head") end
    return character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso") or character:FindFirstChild("HumanoidRootPart")
end

local customPhysics = PhysicalProperties.new(0.0001, 0.3, 0.5, 1, 1)
local blueColor = BrickColor.new("Really blue")
local defaultSize = isWestbound and Vector3.new(2, 1, 1) or Vector3.new(2, 2, 1)

RunService.Heartbeat:Connect(function()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local playerList = Players:GetPlayers()
    local tSize = Vector3.new(_G.MarkerSize, _G.MarkerSize, _G.MarkerSize)
    
    for i = 1, #playerList do
        local player = playerList[i]
        if player ~= LocalPlayer then
            local char = player.Character
            local constraintName = "NoCollide" .. player.Name
            
            if _G.VisualizerEnabled and char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local targetPart = getUniversalTargetPart(char)
                    if targetPart then
                        local enemyRoot = char:FindFirstChild("HumanoidRootPart")
                        targetPart.Size = tSize
                        targetPart.Transparency = _G.HitboxOpacity
                        targetPart.CanCollide = false
                        targetPart.Massless = true
                        targetPart.CanTouch = true
                        targetPart.CanQuery = true
                        targetPart.BrickColor = blueColor
                        targetPart.Material = Enum.Material.SmoothPlastic
                        targetPart.CustomPhysicalProperties = customPhysics
                        
                        if myRoot and enemyRoot then
                            if not myRoot:FindFirstChild(constraintName) then
                                local noCollide = Instance.new("NoCollisionConstraint")
                                noCollide.Name = constraintName
                                noCollide.Part0 = myRoot
                                noCollide.Part1 = enemyRoot
                                noCollide.Parent = myRoot
                            end
                        end
                    end
                elseif myRoot then
                    local staleConstraint = myRoot:FindFirstChild(constraintName)
                    if staleConstraint then staleConstraint:Destroy() end
                end
            elseif char then
                local targetPart = getUniversalTargetPart(char)
                if targetPart and targetPart.Size ~= defaultSize then
                    targetPart.Size = defaultSize
                    targetPart.Transparency = 0
                    targetPart.CanCollide = true
                end
            end
            
            if not _G.VisualizerEnabled or not char or not char:FindFirstChildOfClass("Humanoid") or char:FindFirstChildOfClass("Humanoid").Health <= 0 then
                if myRoot then
                    local staleConstraint = myRoot:FindFirstChild(constraintName)
                    if staleConstraint then staleConstraint:Destroy() end
                end
            end
            
        end
    end
end)

