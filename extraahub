local function refreshVisualConfigList()
    for _, child in ipairs(ScrollingFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for name, data in pairs(savedConfigs) do
        local targetSize = (typeof(data) == "table" and data.Size) or data
        local itemBtn = Instance.new("TextButton", ScrollingFrame)
        itemBtn.Size = UDim2.new(1, -6, 0, 24)
        itemBtn.BackgroundTransparency = 1
        itemBtn.Text = " • " .. tostring(name) .. " (Size: " .. tostring(targetSize) .. ")"
        itemBtn.TextColor3 = Color3.fromRGB(195, 195, 200)
        itemBtn.Font = Enum.Font.Gotham
        itemBtn.TextSize = 11
        itemBtn.TextXAlignment = Enum.TextXAlignment.Left
        itemBtn.ZIndex = 8
        itemBtn.MouseButton1Click:Connect(function()
            ConfigInput.Text = tostring(name)
            ConfigInput:ReleaseFocus()
            ConfigsHeader.Text = "SELECTED: '" .. string.upper(tostring(name)) .. "'"
            task.spawn(function()
                task.wait(1.0)
                ConfigsHeader.Text = "CONFIG LIST"
            end)
        end)
    end
end

local function loadConfigsFromStorageFile()
    if typeof(readfile) == "function" and typeof(isfile) == "function" then
        local existsSuccess, exists = pcall(isfile, "hitbox_profiles.json")
        if existsSuccess and exists then
            local readSuccess, fileContent = pcall(readfile, "hitbox_profiles.json")
            if readSuccess and typeof(fileContent) == "string" and #fileContent > 0 then
                local decodeSuccess, decodedTable = pcall(HttpService.JSONDecode, HttpService, fileContent)
                if decodeSuccess and typeof(decodedTable) == "table" then
                    savedConfigs = decodedTable
                end
            end
        end
    end
end

