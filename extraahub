local trackingMouseActive = false
local function handleSliderMultiplier(input)
    local pct = math.clamp((input.Position.X - SliderTrack.AbsolutePosition.X) / SliderTrack.AbsoluteSize.X, 0, 1)
    _G.MarkerSize = math.floor(5 + (pct * 95))
    SliderLabel.Text = "Target Size Multiplier: " .. tostring(_G.MarkerSize)
    SliderHandle.Position = UDim2.new(pct, -5, 0.5, -5)
    SliderFill.Size = UDim2.new(pct, 0, 1, 0)
end

SliderHandle.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then trackingMouseActive = true end end)
UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then trackingMouseActive = false end end)
UserInputService.InputChanged:Connect(function(input) if trackingMouseActive
and input.UserInputType == Enum.UserInputType.MouseMovement then handleSliderMultiplier(input) end end)

RunService.RenderStepped:Connect(function()
    if not _G.VisualizerEnabled then return end
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local tSize = Vector3.new(_G.MarkerSize, _G.MarkerSize, _G.MarkerSize)
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            pcall(function()
                local char = player.Character
                if char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 and char:FindFirstChild("Head") then
                    local head = char.Head
                    local userId = player.UserId
                    local enemyRoot = char:FindFirstChild("HumanoidRootPart")
                    
                    if entityCache[userId] ~= tSize or head.Size ~= tSize then
                        entityCache[userId] = tSize
                        head.Size = tSize
                        head.Transparency = 0.7
                        head.BrickColor = BrickColor.new("Really blue")
                        head.Material = Enum.Material.SmoothPlastic
                        head.Massless = true
                        head.CustomPhysicalProperties = PhysicalProperties.new(0.0001, 0.3, 0.5, 1, 1)
                        head.CanTouch = true
                        head.CanQuery = true
                        
                        if myRoot and enemyRoot then
                            local constraintName = "NoCollide" .. player.Name
                            if not myRoot:FindFirstChild(constraintName) then
                                local noCollide = Instance.new("NoCollisionConstraint")
                                noCollide.Name = constraintName
                                noCollide.Part0 = myRoot
                                noCollide.Part1 = enemyRoot
                                noCollide.Parent = myRoot
                            end
                        end
                    end
                end
            end)
        end
    end
end)
