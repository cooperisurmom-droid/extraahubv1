local function CreateLogEntry(parent, version, date, changes)
    local Entry = Instance.new("Frame", parent)
    Entry.Size = UDim2.new(1, -24, 0, 0)
    Entry.Position = UDim2.new(0, 12)
    Entry.BackgroundTransparency = 1
    Entry.ZIndex = 7
    Entry.LayoutOrder = 1
    Entry.AutomaticSize = Enum.AutomaticSize.Y

    local VersionLabel = Instance.new("TextLabel", Entry)
    VersionLabel.Size = UDim2.new(1, 0, 0, 18)
    VersionLabel.BackgroundTransparency = 1
    VersionLabel.Text = version .. "  |  " .. date
    VersionLabel.TextColor3 = Color3.fromRGB(60, 120, 255)
    VersionLabel.Font = Enum.Font.GothamBold
    VersionLabel.TextSize = 11
    VersionLabel.TextXAlignment = Enum.TextXAlignment.Left
    VersionLabel.ZIndex = 8

    for i, change in ipairs(changes) do
        local ChangeLabel = Instance.new("TextLabel", Entry)
        ChangeLabel.Size = UDim2.new(1, 0, 0, 16)
        ChangeLabel.Position = UDim2.new(0, 12, 0, 18 + (i-1) * 16)
        ChangeLabel.BackgroundTransparency = 1
        ChangeLabel.Text = "• " .. change
        ChangeLabel.TextColor3 = Color3.fromRGB(170, 180, 200)
        ChangeLabel.Font = Enum.Font.Gotham
        ChangeLabel.TextSize = 10
        ChangeLabel.TextXAlignment = Enum.TextXAlignment.Left
        ChangeLabel.ZIndex = 8
    end

    local entryHeight = 18 + (#changes * 16) + 4
    Entry.Size = UDim2.new(1, -24, 0, entryHeight)
    return Entry
end

