local function hasWallBetween(fromPos, toPos, character)
    local direction = toPos - fromPos
    local distance = direction.Magnitude
    if distance < 1 then return false end
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local excludeList = {LocalPlayer.Character, character}
    rayParams.FilterDescendantsInstances = excludeList
    rayParams.IgnoreWater = true
    local result = workspace:Raycast(fromPos, direction.Unit * distance, rayParams)
    return result ~= nil
end

local function isValidTarget(head)
    if not head or not head.Parent then return false end
    local character = head.Parent
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    local player = Players:GetPlayerFromCharacter(character)
    if not player or player == LocalPlayer then return false end
    if _G.TeamCheck and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
        return false
    end
    if _G.WallCheck then
        local camPos = Camera.CFrame.Position
        if hasWallBetween(camPos, head.Position, character) then
            return false
        end
    end
    return true
end

local function findNewTargetInFOV()
    local mousePos = UserInputService:GetMouseLocation()
    local closest = nil
    local shortest = _G.AimbotFOV
    local camPos = Camera.CFrame.Position

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            if _G.TeamCheck and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
                continue
            end
            local head = player.Character.Head
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health <= 0 then continue end
            if _G.WallCheck and hasWallBetween(camPos, head.Position, player.Character) then continue end
            local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
            if onScreen and screenPos.Z > 0 then
                local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                if dist < shortest then
                    shortest = dist
                    closest = head
                end
            end
        end
    end
    return closest
end

local function getAimTarget(keyIsDown)
    if not keyIsDown then
        lastAimTarget = nil
        return nil
    end

    if lastAimTarget and isValidTarget(lastAimTarget) then
        return lastAimTarget
    end

    local newTarget = findNewTargetInFOV()
    if newTarget then
        lastAimTarget = newTarget
        return newTarget
    end

    lastAimTarget = nil
    return nil
end

local function updateFOVCircle()
    local hasDrawing = typeof(Drawing) == "table" and typeof(Drawing.new) == "function"
    if not hasDrawing then return end

    if fovCircle then
        pcall(function() fovCircle:Remove() end)
        fovCircle = nil
    end

    if _G.ShowFOV and _G.AimbotEnabled then
        local mouse = UserInputService:GetMouseLocation()
        fovCircle = Drawing.new("Circle")
        fovCircle.Visible = true
        fovCircle.Color = Color3.fromRGB(255, 255, 255)
        fovCircle.Thickness = 1.2
        fovCircle.Transparency = 0.75
        fovCircle.Filled = false
        fovCircle.NumSides = 64
        fovCircle.Radius = _G.AimbotFOV
        fovCircle.Position = mouse
    end
end

RunService.RenderStepped:Connect(function()
    local minDown = isMinimizeKeyDown()
    if minDown and not minimizeKeyWasDown then
        MainWindow.Visible = not MainWindow.Visible
    end
    minimizeKeyWasDown = minDown

    updateESP()
    updateFOVCircle()

    if _G.AimbotEnabled then
        local keyActive = false
        if typeof(_G.AimbotKeybind) == "EnumItem" then
            if _G.AimbotKeybind.EnumType == Enum.KeyCode then
                keyActive = UserInputService:IsKeyDown(_G.AimbotKeybind)
            else
                keyActive = UserInputService:IsMouseButtonPressed(_G.AimbotKeybind)
            end
        end
        local target = getAimTarget(keyActive)
        if target then
            if Camera.CameraType == Enum.CameraType.Scriptable then
                Camera.CameraType = Enum.CameraType.Custom
            end
            local camPos = Camera.CFrame.Position
            local targetPos = target.Position
            local lookCF = CFrame.new(camPos, targetPos)
            local smooth = math.clamp(math.max(_G.AimbotSmooth, 0.55), 0.05, 1)
            Camera.CFrame = Camera.CFrame:Lerp(lookCF, smooth)
        end
    else
        lastAimTarget = nil
        if Camera.CameraType == Enum.CameraType.Scriptable then
            Camera.CameraType = Enum.CameraType.Custom
        end
    end

    if _G.VisualizerEnabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local head = player.Character:FindFirstChild("Head")
                if head then
                    if not originalSizes[head] then
                        originalSizes[head] = {
                            Size = head.Size,
                            CanCollide = head.CanCollide,
                            Massless = head.Massless
                        }
                    end
                    local s = _G.MarkerSize
                    head.Size = Vector3.new(s, s, s)
                    head.CanCollide = false
                    head.Massless = true
                    head.Transparency = 1 - _G.HitboxOpacity
                    head.Material = Enum.Material.Neon
                    head.Color = Color3.fromRGB(255, 0, 0)
                end
            end
        end
    else
        for head, data in pairs(originalSizes) do
            if head and head.Parent then
                head.Size = data.Size
                head.CanCollide = data.CanCollide
                head.Massless = data.Massless
                head.Transparency = 0
                head.Material = Enum.Material.Plastic
            end
        end
        table.clear(originalSizes)
    end
end)

