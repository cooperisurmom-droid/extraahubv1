local dragging, dragInput, dragStart, startPos = false, nil, nil, nil
local trackingMouseActive = false
local trackingOpacityActive = false

TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        
        local connection
        connection = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                connection:Disconnect()
            end
        end)
    end
end)

TitleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        dragInput = input
    end
end)

local function handleSliderMultiplier(input)
    local trackWidth = SliderTrack.AbsoluteSize.X
    if trackWidth <= 0 then return end
    local pct = math.clamp((input.Position.X - SliderTrack.AbsolutePosition.X) / trackWidth, 0, 1)
    _G.MarkerSize = math.floor(5 + (pct * 95))
    SliderLabel.Text = "Target Size Multiplier: " .. tostring(_G.MarkerSize)
    SliderHandle.Position = UDim2.new(pct, -5, 0.5, -5)
    SliderFill.Size = UDim2.new(pct, 0, 1, 0)
end

local function handleOpacityMultiplier(input)
    local trackWidth = OpacityTrack.AbsoluteSize.X
    if trackWidth <= 0 then return end
    local pct = math.clamp((input.Position.X - OpacityTrack.AbsolutePosition.X) / trackWidth, 0, 1)
    _G.HitboxOpacity = math.floor(pct * 100) / 100
    OpacityLabel.Text = "Hitbox Opacity: " .. string.format("%.2f", _G.HitboxOpacity)
    OpacityHandle.Position = UDim2.new(pct, -5, 0.5, -5)
    OpacityFill.Size = UDim2.new(pct, 0, 1, 0)
end

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        if dragging and dragInput then
            local delta = input.Position - dragStart
            local targetPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            TweenService:Create(MainFrame, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = targetPos}):Play()
        end
        if trackingMouseActive then
            handleSliderMultiplier(input)
        end
        if trackingOpacityActive then
            handleOpacityMultiplier(input)
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
        trackingMouseActive = false
        trackingOpacityActive = false
    end
end)

local bindingKeyActive = false
KeybindBtn.MouseButton1Click:Connect(function()
    if bindingKeyActive then return end
    bindingKeyActive = true
    KeybindBtn.Text = "Press any key..."
    local captureConnection
    captureConnection = UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
            KeybindBtn.Text = "Minimalize GUI: [ " .. _G.CloseKeybind.Name .. " ]"
            captureConnection:Disconnect()
            task.wait()
            bindingKeyActive = false
            return
        end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            _G.CloseKeybind = input.KeyCode
            KeybindBtn.Text = "Minimalize GUI: [ " .. input.KeyCode.Name .. " ]"
            captureConnection:Disconnect()
            task.wait()
            bindingKeyActive = false
        end
    end)
end)

LoadBtn.MouseButton1Click:Connect(function()
    local profileName = ConfigInput.Text
    if profileName == "" then return end
    ConfigInput:ReleaseFocus()
    local data = savedConfigs[profileName]
    if data then
        if typeof(data) == "table" then
            _G.MarkerSize = data.Size or _G.MarkerSize
            _G.HitboxOpacity = data.Opacity or 0.7
            updateTrackbarLayout(_G.MarkerSize)
            updateOpacityLayout(_G.HitboxOpacity)
        else
            _G.MarkerSize = data
            updateTrackbarLayout(_G.MarkerSize)
        end
        ConfigsHeader.Text = "LOADED '" .. string.upper(tostring(profileName)) .. "'"
    else
        ConfigsHeader.Text = "NOT FOUND"
    end
    task.spawn(function()
        task.wait(1.5)
        ConfigsHeader.Text = "PROFILE MANAGER"
    end)
end)

OverwriteBtn.MouseButton1Click:Connect(function()
    local profileName = ConfigInput.Text
    if profileName == "" then return end
    ConfigInput:ReleaseFocus()
    if savedConfigs[profileName] then
        savedConfigs[profileName] = {
            Size = _G.MarkerSize,
            Opacity = _G.HitboxOpacity or 0.7
        }
        saveConfigsToStorageFile()
        refreshVisualConfigList()
        ConfigsHeader.Text = "OVERWROTE '" .. string.upper(tostring(profileName)) .. "'"
    else
        ConfigsHeader.Text = "ERROR: NOT FOUND"
    end
    task.spawn(function()
        task.wait(1.5)
        ConfigsHeader.Text = "PROFILE MANAGER"
    end)
end)

DeleteBtn.MouseButton1Click:Connect(function()
    local profileName = ConfigInput.Text
    if profileName == "" then return end
    ConfigInput:ReleaseFocus()
    if savedConfigs[profileName] then
        savedConfigs[profileName] = nil
        ConfigInput.Text = ""
        saveConfigsToStorageFile()
        refreshVisualConfigList()
        ConfigsHeader.Text = "DELETED '" .. string.upper(tostring(profileName)) .. "'"
    else
        ConfigsHeader.Text = "ERROR: NOT FOUND"
    end
    task.spawn(function()
        task.wait(1.5)
        ConfigsHeader.Text = "PROFILE MANAGER"
    end)
end)

UserInputService.InputBegan:Connect(function(input, processed)
    if processed or UserInputService:GetFocusedTextBox() then return end
    local targetBind = _G.CloseKeybind
    local isMinusKey = (input.KeyCode == targetBind) or (input.KeyCode == Enum.KeyCode.KeypadMinus and targetBind == Enum.KeyCode.Minus) or (input.KeyCode == Enum.KeyCode.Minus and targetBind == Enum.KeyCode.KeypadMinus)
    if isMinusKey then
        ScreenGui.Enabled = not ScreenGui.Enabled
    end
end)

ToggleBtn.MouseButton1Click:Connect(function()
    _G.VisualizerEnabled = not _G.VisualizerEnabled
    ToggleBtn.BackgroundColor3 = _G.VisualizerEnabled and Color3.fromRGB(0, 125, 255) or Color3.fromRGB(150, 35, 35)
    ToggleBtn.Text = _G.VisualizerEnabled and "Status: Enabled" or "Status: Disabled"
end)

