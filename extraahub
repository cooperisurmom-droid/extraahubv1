local function clearESP()
    for key, box in pairs(espBoxes) do
        if box then
            if type(box) == "table" and box.billboard then
                pcall(function() box.billboard:Destroy() end)
            elseif typeof(box.Remove) == "function" then
                pcall(function() box:Remove() end)
            elseif box.Parent then
                box:Destroy()
            end
        end
    end
    table.clear(espBoxes)
end

local function updateESP()
    if not _G.ESPEnabled then
        clearESP()
        return
    end

    local active = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            if _G.ESPTeamCheck and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
                continue
            end

            local root = player.Character.HumanoidRootPart
            local key = player.UserId
            active[key] = true

            local boxData = espBoxes[key]
            if not boxData or not boxData.billboard or not boxData.billboard.Parent then
                if boxData and boxData.billboard then
                    pcall(function() boxData.billboard:Destroy() end)
                end

                local billboard = Instance.new("BillboardGui")
                billboard.Name = "ESPBox_" .. player.Name
                billboard.Adornee = root
                billboard.AlwaysOnTop = true
                billboard.Size = UDim2.new(4, 0, 6, 0)
                billboard.StudsOffset = Vector3.new(0, 0.5, 0)
                billboard.MaxDistance = 100000
                billboard.Parent = ScreenGui

                local frame = Instance.new("Frame", billboard)
                frame.Size = UDim2.new(1, 0, 1, 0)
                frame.BackgroundTransparency = 1
                frame.BorderSizePixel = 0

                local stroke = Instance.new("UIStroke", frame)
                stroke.Color = _G.ESPColor
                stroke.Thickness = 2
                stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

                espBoxes[key] = { billboard = billboard, stroke = stroke }
            else
                boxData.stroke.Color = _G.ESPColor
                boxData.billboard.Adornee = root
            end
        end
    end

    for key, boxData in pairs(espBoxes) do
        if not active[key] then
            if boxData.billboard then
                pcall(function() boxData.billboard:Destroy() end)
            end
            espBoxes[key] = nil
        end
    end
end

