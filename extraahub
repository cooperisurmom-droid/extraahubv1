local function getPlayerTeam(player)
    if player:FindFirstChild("Team") then
        local teamValue = player.Team
        if typeof(teamValue) == "Instance" and teamValue:IsA("Team") then return teamValue
        elseif typeof(teamValue) == "string" or typeof(teamValue) == "number" then return tostring(teamValue) end
    end
    if player.Character then
        local char = player.Character
        if char:FindFirstChild("TeamColor") then return char.TeamColor.Value end
        if char:FindFirstChild("Team") then return char.Team.Value end
        if char:FindFirstChild("Outlaws") then return "Outlaws" end
        if char:FindFirstChild("Lawmen") then return "Lawmen" end
        if char:FindFirstChild("Bandits") then return "Bandits" end
        if char:FindFirstChild("Sheriff") then return "Sheriff" end
    end
    return player.Team
end

local function isOnSameTeam(player1, player2)
    local team1 = getPlayerTeam(player1)
    local team2 = getPlayerTeam(player2)
    if not team1 or not team2 then return false end
    if typeof(team1) == "Instance" and typeof(team2) == "Instance" then return team1 == team2 end
    return tostring(team1) == tostring(team2)
end

