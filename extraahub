local function CreateTab(name, order)
    local TabButton = Instance.new("TextButton", TabContainer)
    TabButton.Size = UDim2.new(1, -12, 0, 32)
    TabButton.BackgroundTransparency = 1
    TabButton.Text = " " .. name
    TabButton.TextColor3 = Color3.fromRGB(140, 150, 170)
    TabButton.Font = Enum.Font.GothamSemibold
    TabButton.TextSize = 13
    TabButton.TextXAlignment = Enum.TextXAlignment.Left
    TabButton.LayoutOrder = order
    TabButton.ZIndex = 6
    local PageFrame = Instance.new("ScrollingFrame", ContentFrame)
    PageFrame.Size = UDim2.new(1, 0, 1, 0)
    PageFrame.BackgroundTransparency = 1
    PageFrame.BorderSizePixel = 0
    PageFrame.Visible = false
    PageFrame.ScrollBarThickness = 4
    PageFrame.ScrollBarImageColor3 = Color3.fromRGB(80, 90, 110)
    PageFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    PageFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    PageFrame.ZIndex = 5
    local ContentPadding = Instance.new("UIPadding", PageFrame)
    ContentPadding.PaddingLeft = UDim.new(0, 15)
    ContentPadding.PaddingTop = UDim.new(0, 15)
    ContentPadding.PaddingRight = UDim.new(0, 15)
    ContentPadding.PaddingBottom = UDim.new(0, 25)
    local ContentLayout = Instance.new("UIListLayout", PageFrame)
    ContentLayout.SortOrder = Enum.SortOrder.LayoutOrder
    ContentLayout.Padding = UDim.new(0, 10)
    TabButton.MouseButton1Click:Connect(function()
        if currentTabFrame then
            currentTabFrame.Button.BackgroundTransparency = 1
            currentTabFrame.Button.TextColor3 = Color3.fromRGB(140, 150, 170)
            currentTabFrame.Frame.Visible = false
        end
        currentTabFrame = {Button = TabButton, Frame = PageFrame}
        TabButton.BackgroundTransparency = 0
        TabButton.BackgroundColor3 = Color3.fromRGB(33, 40, 52)
        TabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        Instance.new("UICorner", TabButton).CornerRadius = UDim.new(0, 4)
        PageFrame.Visible = true
    end)
    return PageFrame, TabButton
end

