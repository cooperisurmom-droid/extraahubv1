local function updateESP()
    if not _G.ESPEnabled then
        clearESP()
        return
    end
    local active = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            if _G.ESPTeamCheck and isOnSameTeam(p, LocalPlayer) then
                continue
            end
            local root = p.Character.HumanoidRootPart
            active[p.UserId] = true
            if not espBoxes[p.UserId] then
                local bill = Instance.new("BillboardGui")
                bill.Parent = ScreenGui
                bill.Adornee = root
                bill.AlwaysOnTop = true
                bill.Size = UDim2.new(4, 0, 6, 0)
                bill.StudsOffset = Vector3.new(0, 0.5, 0)
                bill.MaxDistance = 100000
                local frame = Instance.new("Frame", bill)
                frame.Size = UDim2.new(1, 0, 1, 0)
                frame.BackgroundTransparency = 1
                local stroke = Instance.new("UIStroke", frame)
                stroke.Color = _G.ESPColor
                stroke.Thickness = 2
                stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                espBoxes[p.UserId] = { billboard = bill, stroke = stroke }
            else
                espBoxes[p.UserId].stroke.Color = _G.ESPColor
                espBoxes[p.UserId].billboard.Adornee = root
            end
        end
    end
    for k, v in pairs(espBoxes) do
        if not active[k] then
            pcall(v.billboard.Destroy, v.billboard)
            espBoxes[k] = nil
        end
    end
end

local lastAimTarget = nil

local function hasWallBetween(from, to, char)
    local dir = to - from
    if dir.Magnitude < 1 then return false end
    local r = RaycastParams.new()
    r.FilterType = Enum.RaycastFilterType.Exclude
    r.FilterDescendantsInstances = {LocalPlayer.Character, char}
    r.IgnoreWater = true
    return workspace:Raycast(from, dir.Unit * dir.Magnitude, r) ~= nil
end

local function isValidTarget(head)
    if not head or not head.Parent then return false end
    local char = head.Parent
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    local p = Players:GetPlayerFromCharacter(char)
    if not p or p == LocalPlayer then return false end
    if _G.TeamCheck and isOnSameTeam(p, LocalPlayer) then return false end
    if _G.WallCheck then
        local camPos = Camera.CFrame.Position
        if hasWallBetween(camPos, head.Position, char) then return false end
    end
    return true
end

local function findTargetInFOV()
    local mouse = UserInputService:GetMouseLocation()
    local short = _G.AimbotFOV
    local closest = nil
    local cam = Camera.CFrame.Position
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local part = _G.AimbotTarget == "Head" and p.Character:FindFirstChild("Head") or p.Character:FindFirstChild("HumanoidRootPart")
            if part and not (_G.TeamCheck and isOnSameTeam(p, LocalPlayer)) then
                local h = p.Character:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 then
                    if _G.WallCheck and hasWallBetween(cam, part.Position, p.Character) then
                        continue
                    end
                    local sp, on = Camera:WorldToViewportPoint(part.Position)
                    if on and sp.Z > 0 then
                        local dist = (Vector2.new(sp.X, sp.Y) - mouse).Magnitude
                        if dist < short then
                            short = dist
                            closest = part
                        end
                    end
                end
            end
        end
    end
    return closest
end

local function getAimTarget(down)
    if not down then
        lastAimTarget = nil
        return nil
    end
    if lastAimTarget and isValidTarget(lastAimTarget) then
        return lastAimTarget
    end
    local t = findTargetInFOV()
    if t then
        lastAimTarget = t
        return t
    end
    lastAimTarget = nil
    return nil
end

local function updateFOVCircle()
    local hasDrawing = typeof(Drawing) == "table" and typeof(Drawing.new) == "function"
    if not hasDrawing then return end
    if fovCircle then
        pcall(function() fovCircle:Remove() end)
        fovCircle = nil
    end
    if _G.ShowFOV and _G.AimbotEnabled then
        local mouse = UserInputService:GetMouseLocation()
        fovCircle = Drawing.new("Circle")
        fovCircle.Visible = true
        fovCircle.Color = Color3.fromRGB(255, 255, 255)
        fovCircle.Thickness = 1
        fovCircle.Transparency = 0.8
        fovCircle.Filled = false
        fovCircle.NumSides = 64
        fovCircle.Radius = _G.AimbotFOV
        fovCircle.Position = mouse
    end
end

RunService.RenderStepped:Connect(function()
    local minDown = isMinimizeKeyDown()
    if minDown and not minimizeKeyWasDown then
        MainWindow.Visible = not MainWindow.Visible
    end
    minimizeKeyWasDown = minDown

    updateESP()
    updateFOVCircle()

    if _G.AimbotEnabled then
        local keyActive = false
        if typeof(_G.AimbotKeybind) == "EnumItem" then
            if _G.AimbotKeybind.EnumType == Enum.KeyCode then
                keyActive = UserInputService:IsKeyDown(_G.AimbotKeybind)
            else
                keyActive = UserInputService:IsMouseButtonPressed(_G.AimbotKeybind)
            end
        end
        local target = getAimTarget(keyActive)
        if target then
            if Camera.CameraType == Enum.CameraType.Scriptable then
                Camera.CameraType = Enum.CameraType.Custom
            end
            local camPos = Camera.CFrame.Position
            local targetPos = target.Position
            local lookCF = CFrame.new(camPos, targetPos)
            local smooth = math.clamp(math.max(_G.AimbotSmooth, 0.55), 0.05, 1)
            Camera.CFrame = Camera.CFrame:Lerp(lookCF, smooth)
        end
    else
        lastAimTarget = nil
        if Camera.CameraType == Enum.CameraType.Scriptable then
            Camera.CameraType = Enum.CameraType.Custom
        end
    end

    if _G.VisualizerEnabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                if _G.HitboxTeamCheck and isOnSameTeam(player, LocalPlayer) then
                    local head = player.Character:FindFirstChild("Head")
                    if head and originalSizes[head] then
                        local data = originalSizes[head]
                        head.Size = data.Size
                        head.CanCollide = data.CanCollide
                        head.Massless = data.Massless
                        head.Transparency = 0
                        head.Material = Enum.Material.Plastic
                        originalSizes[head] = nil
                    end
                    continue
                end
                local head = player.Character:FindFirstChild("Head")
                if head then
                    if not originalSizes[head] then
                        originalSizes[head] = {
                            Size = head.Size,
                            CanCollide = head.CanCollide,
                            Massless = head.Massless
                        }
                    end
                    local s = _G.MarkerSize
                    head.Size = Vector3.new(s, s, s)
                    head.CanCollide = false
                    head.Massless = true
                    head.Transparency = 1 - _G.HitboxOpacity
                    head.Material = Enum.Material.Neon
                    head.Color = Color3.fromRGB(255, 0, 0)
                end
            end
        end
    else
        for head, data in pairs(originalSizes) do
            if head and head.Parent then
                head.Size = data.Size
                head.CanCollide = data.CanCollide
                head.Massless = data.Massless
                head.Transparency = 0
                head.Material = Enum.Material.Plastic
            end
        end
        table.clear(originalSizes)
    end

    if _G.ZoAntiHit and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
                part.Massless = true
            end
        end
    end

    if _G.ZoNoAnimations and LocalPlayer.Character then
        local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.Animator = nil
        end
    end    if _G.ZoDesync and LocalPlayer.Character then
        local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if root then
            root.CFrame = root.CFrame + Vector3.new(0, 0.1, 0)
            task.wait(0.05)
            root.CFrame = root.CFrame - Vector3.new(0, 0.1, 0)
        end
    end
end)
