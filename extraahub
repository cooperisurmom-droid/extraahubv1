local function BuildPremiumSlider(parent, labelText, yPos, min, max, default, globalVarName, isOpacity)
    local SliderRow = Instance.new("Frame", parent)
    SliderRow.Size = UDim2.new(1, -24, 0, 34)
    SliderRow.Position = UDim2.new(0, 12, 0, yPos)
    SliderRow.BackgroundTransparency = 1
    SliderRow.ZIndex = 7
    local Label = Instance.new("TextLabel", SliderRow)
    Label.Size = UDim2.new(0.6, 0, 1, 0)
    Label.BackgroundTransparency = 1
    Label.Text = labelText
    Label.TextColor3 = Color3.fromRGB(200, 205, 215)
    Label.Font = Enum.Font.GothamSemibold
    Label.TextSize = 12
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.ZIndex = 8
    local ValueBox = Instance.new("Frame", SliderRow)
    ValueBox.Size = UDim2.new(0, 42, 0, 20)
    ValueBox.Position = UDim2.new(1, -36, 0.5, -10)
    ValueBox.BackgroundColor3 = Color3.fromRGB(17, 21, 28)
    ValueBox.ZIndex = 8
    Instance.new("UICorner", ValueBox).CornerRadius = UDim.new(0, 4)
    Instance.new("UIStroke", ValueBox).Color = Color3.fromRGB(33, 40, 52)
    local ValueLabel = Instance.new("TextLabel", ValueBox)
    ValueLabel.Size = UDim2.new(1, 0, 1, 0)
    ValueLabel.BackgroundTransparency = 1
    ValueLabel.Text = isOpacity and string.format("%.2f", default) or tostring(default)
    ValueLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    ValueLabel.Font = Enum.Font.GothamBold
    ValueLabel.TextSize = 11
    ValueLabel.ZIndex = 9
    local Track = Instance.new("Frame", SliderRow)
    Track.Size = UDim2.new(1, -50, 0, 3)
    Track.Position = UDim2.new(0, 0, 1, -4)
    Track.BackgroundColor3 = Color3.fromRGB(33, 40, 52)
    Track.BorderSizePixel = 0
    Track.ZIndex = 8
    local Fill = Instance.new("Frame", Track)
    local basePct = math.clamp((default - min) / (max - min), 0, 1)
    Fill.Size = UDim2.new(basePct, 0, 1, 0)
    Fill.BackgroundColor3 = Color3.fromRGB(59, 130, 246)
    Fill.BorderSizePixel = 0
    Fill.ZIndex = 9
    local Handle = Instance.new("TextButton", Track)
    Handle.Size = UDim2.new(0, 10, 0, 10)
    Handle.Position = UDim2.new(basePct, -5, 0.5, -5)
    Handle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Handle.Text = ""
    Handle.ZIndex = 10
    Instance.new("UICorner", Handle).CornerRadius = UDim.new(1, 0)
    return Track, Fill, Handle, ValueLabel, min, max, isOpacity, globalVarName
end

