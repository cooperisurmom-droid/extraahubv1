local function saveConfigsToStorageFile()
    if writefile then
        local success, jsonString = pcall(function()
            return HttpService:JSONEncode(savedConfigs)
        end)
        if success then
            writefile("hitbox_profiles.json", jsonString)
        end
    end
end

local function loadConfigsFromStorageFile()
    if readfile and isfile and isfile("hitbox_profiles.json") then
        local fileContent = readfile("hitbox_profiles.json")
        local success, decodedTable = pcall(function()
            return HttpService:JSONDecode(fileContent)
        end)
        if success and type(decodedTable) == "table" then
            savedConfigs = decodedTable
        end
    end
end

local function refreshVisualConfigList()
    for _, child in ipairs(ScrollingFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    local count = 0
    for name, size in pairs(savedConfigs) do
        count = count + 1
        local itemBtn = Instance.new("TextButton", ScrollingFrame)
        itemBtn.Size = UDim2.new(1, -6, 0, 22)
        itemBtn.BackgroundTransparency = 1
        itemBtn.Text = "  • " .. name .. "  (Size: " .. tostring(size) .. ")"
        itemBtn.TextColor3 = Color3.fromRGB(195, 195, 200)
        itemBtn.Font = Enum.Font.Gotham
        itemBtn.TextSize = 11
        itemBtn.TextXAlignment = Enum.TextXAlignment.Left
        itemBtn.MouseButton1Click:Connect(function()
            ConfigInput.Text = name
            ConfigInput:ReleaseFocus()
            ConfigsHeader.Text = "SELECTED: '" .. string.upper(name) .. "'"
            task.wait(1.0)
            ConfigsHeader.Text = "PROFILE MANAGER"
        end)
    end
    ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, count * 24)
end

loadConfigsFromStorageFile()
