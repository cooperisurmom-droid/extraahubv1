SaveBtn.MouseButton1Click:Connect(function()
    local profileName = ConfigInput.Text:gsub("%s+", "")
    if profileName == "" then return end
    savedConfigs[profileName] = { Size = _G.MarkerSize, Opacity = _G.HitboxOpacity }
    ConfigInput.Text = ""
    ConfigInput:ReleaseFocus()
    saveConfigsToStorageFile()
    refreshVisualConfigList()
    ConfigsHeader.Text = "SAVED '" .. string.upper(tostring(profileName)) .. "'"
    task.spawn(function() task.wait(1.5) ConfigsHeader.Text = "CONFIG LIST" end)
end)

LoadBtn.MouseButton1Click:Connect(function()
    local profileName = ConfigInput.Text:gsub("%s+", "")
    if profileName == "" or not savedConfigs[profileName] then return end
    ConfigInput:ReleaseFocus()
    local data = savedConfigs[profileName]
    if typeof(data) == "table" then
        _G.MarkerSize = data.Size or _G.MarkerSize
        _G.HitboxOpacity = data.Opacity or _G.HitboxOpacity
    else
        _G.MarkerSize = tonumber(data) or _G.MarkerSize
    end
    updateTrackbarLayout(_G.MarkerSize)
    updateOpacityLayout(_G.HitboxOpacity)
    ConfigsHeader.Text = "LOADED '" .. string.upper(tostring(profileName)) .. "'"
    task.spawn(function() task.wait(1.5) ConfigsHeader.Text = "CONFIG LIST" end)
end)

